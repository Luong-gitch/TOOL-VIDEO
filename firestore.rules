rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2048)) &&
             data.planName in ['Starter', 'Pro Creator', 'Studio', 'Enterprise'] &&
             data.credits is number && data.credits >= 0 &&
             data.totalGenerated is number && data.totalGenerated >= 0 &&
             data.monthlyQuota is number && data.monthlyQuota >= 0;
    }

    function isValidUserTask(data) {
      return data.id is string && isValidId(data.id) &&
             data.provider is string && data.provider.size() <= 64 &&
             data.model is string && data.model.size() <= 64 &&
             data.mode is string && data.mode.size() <= 32 &&
             data.prompt is string && data.prompt.size() <= 5000 &&
             (!('enhancedPrompt' in data) || (data.enhancedPrompt is string && data.enhancedPrompt.size() <= 5000)) &&
             (!('negativePrompt' in data) || (data.negativePrompt is string && data.negativePrompt.size() <= 2000)) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 2048)) &&
             (!('lastFrameUrl' in data) || (data.lastFrameUrl is string && data.lastFrameUrl.size() <= 2048)) &&
             data.aspectRatio is string && data.aspectRatio.size() <= 16 &&
             data.resolution is string && data.resolution.size() <= 16 &&
             data.duration is number &&
             data.status is string && data.status.size() <= 32 &&
             data.progress is number &&
             data.creditsCost is number;
    }

    function isValidProject(data) {
      return data.id is string && isValidId(data.id) &&
             data.title is string && data.title.size() <= 256 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 4000)) &&
             data.category is string && data.category.size() <= 64 &&
             data.aspectRatio is string && data.aspectRatio.size() <= 16 &&
             data.defaultProvider is string && data.defaultProvider.size() <= 64 &&
             data.status is string && data.status.size() <= 32;
    }

    // Health check collection
    match /test/{docId} {
      allow get: if true;
      allow write: if false;
    }

    // User profile documents and personal subcollections
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidUserProfile(incoming()) && incoming().uid == userId;
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) && incoming().uid == userId;
      allow delete: if false;

      // User's personal video generation tasks
      match /tasks/{taskId} {
        allow get: if isOwner(userId) && isValidId(taskId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(taskId) && isValidUserTask(incoming());
        allow update: if isOwner(userId) && isValidId(taskId) && isValidUserTask(incoming());
        allow delete: if isOwner(userId) && isValidId(taskId);
      }

      // User's personal video production projects
      match /projects/{projectId} {
        allow get: if isOwner(userId) && isValidId(projectId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(projectId) && isValidProject(incoming());
        allow update: if isOwner(userId) && isValidId(projectId) && isValidProject(incoming());
        allow delete: if isOwner(userId) && isValidId(projectId);
      }
    }

    // Top-level tasks collection fallback if shared/synced
    match /tasks/{taskId} {
      allow get: if isSignedIn() && isValidId(taskId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(taskId) && isValidUserTask(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(taskId) && isValidUserTask(incoming()) && existing().userId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(taskId) && existing().userId == request.auth.uid;
    }
  }
}
